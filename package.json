{
  "name": "sinpefacil",
  "private": true,
  "version": "0.0.1",
  "description": "sinpefacil",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Absulit/sinpefacil.git"
  },
  "type": "module",
  "license": "MIT",
  "scripts": {
    "start": "npm run dev; npm audit; npm outdated",
    "dev": "cross-env NODE_ENV=development vite",
    "build": "cross-env NODE_ENV=production vite build && npx workbox generateSW workbox-config.cjs; npm audit; npm outdated",
    "postinstall": "cpy --flat ./node_modules/framework7-icons/fonts/*.* ./src/fonts/ && cpy --flat ./node_modules/material-icons/iconfont/*.* ./src/fonts/",
    "assets": "npx framework7-cli generate-assets"
  },
  "browserslist": [
    "IOS >= 15",
    "Safari >= 15",
    "last 5 Chrome versions",
    "last 5 Firefox versions"
  ],
  "dependencies": {
    "dexie": "4.4.5",
    "dom7": "4.0.6",
    "framework7": "9.1.2",
    "framework7-icons": "5.0.5",
    "i18next": "26.4.0",
    "material-icons": "1.13.14",
    "qr-code-styling": "1.9.2",
    "qr-scanner": "^1.4.2",
    "skeleton-elements": "4.0.1",
    "swiper": "14.1.0"
  },
  "devDependencies": {
    "@vitejs/plugin-basic-ssl": "^2.3.0",
    "cpy-cli": "7.0.0",
    "cross-env": "10.1.0",
    "postcss-preset-env": "11.4.0",
    "rollup-plugin-framework7": "1.2.1",
    "vite": "8.2.1",
    "workbox-cli": "7.4.1"
  },
  "overrides": {
    "tmp": "^0.2.3"
  }
}