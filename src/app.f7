    <!-- Create QR product Popup -->
    <div class="popup qr-data-popup">
      <div class="page">
        <div class="navbar">
          <div class="navbar-bg"></div>
          <div class="navbar-inner">
            <div class="title">${productId ? i18next.t('codes:editTitle') : i18next.t('codes:addTitle') }</div>
            <div class="right">
              <!-- Close button -->
              <a class="link popup-close">
                <i class="icon if-not-md f7-icons">xmark</i>
                <i class="icon if-md material-icons">close</i>
              </a>
            </div>
          </div>
        </div>

        <div class="page-content">
          <div class="toolbar toolbar-bottom messagebar-area no-shadow">
            <div class="toolbar-inner display-flex justify-content-center align-items-center padding-horizontal">
              <span class="text-color-gray size-12 padding-half">
                <i class="icon f7-icons if-not-md">info_circle</i>
                <i class="icon material-icons if-md">info</i>
              </span>
              160 caracteres máximo, 70 si hay especiales. Usados: ${numChars}.
            </div>
          </div>


          <form class="list" id="qr-data-form">
            <ul>
              <li class="item-content item-input">
                <div class="item-inner">
                  <div class="item-title item-label">${i18next.t('codes:phone')}</div>
                  <div class="item-input-wrap">
                    <input id="phone" name="phone" autocomplete="tel" inputmode="tel" maxlength="8" minlength="8"
                      type="tel" validate placeholder="${i18next.t('codes:phonePlaceholder')}" required />
                    <span class="input-clear-button"></span>
                  </div>
                </div>
              </li>

              <li class="item-content item-input">
                <div class="item-inner">
                  <div class="item-title item-label">${i18next.t('codes:name')}</div>
                  <div class="item-input-wrap">
                    <input type="text" name="name" autocomplete="name"
                      placeholder="${i18next.t('codes:namePlaceholder')}" required validate />
                    <span class="input-clear-button"></span>
                  </div>
                </div>
              </li>

              <li class="item-content item-input">
                <div class="item-inner">
                  <div class="item-title item-label">${i18next.t('codes:price')}</div>
                  <div class="item-input-wrap">
                    <input type="tel" name="price" placeholder="${i18next.t('codes:pricePlaceholder')}"
                      inputmode="decimal" required validate />
                    <span class="input-clear-button"></span>
                  </div>
                </div>
              </li>

              <li class="item-content item-input">
                <div class="item-inner">
                  <div class="item-title item-label">${i18next.t('codes:detail')}</div>
                  <div class="item-input-wrap">
                    <input type="text" name="detail" placeholder="${i18next.t('codes:detailPlaceholder')}" validate
                      maxlength="160" />
                    <span class="input-clear-button"></span>
                  </div>
                </div>
              </li>

            </ul>

            <div class="block">
              <button type="button" class="button button-fill" @click="${submitForm}">
                ${productId ? i18next.t('codes:submitButtonEdit') : i18next.t('codes:submitButtonAdd')}
              </button>
            </div>
          </form>



          <div class="block-title">Ejemplo de SMS</div>
          <div class="block" class="card">
