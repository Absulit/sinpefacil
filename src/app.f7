<template>
  <div id="app">

    <!-- Left panel with cover effect-->
    <div class="panel panel-left panel-cover dark panel-init">
      <div class="view">
        <div class="page">
          <div class="navbar">
            <div class="navbar-bg"></div>
            <div class="navbar-inner">
              <div class="title">Left Panel</div>
            </div>
          </div>
          <div class="page-content">
            <div class="block">Left panel content goes here</div>
          </div>
        </div>
      </div>
    </div>
    <!-- Right panel with reveal effect-->
    <div class="panel panel-right panel-reveal dark">
      <div class="view">
        <div class="page">
          <div class="navbar">
            <div class="navbar-bg"></div>
            <div class="navbar-inner">
              <div class="title">Right Panel</div>
            </div>
          </div>
          <div class="page-content">
            <div class="block">Right panel content goes here</div>
          </div>
        </div>
      </div>
    </div>

    <!-- Create QR product Popup -->
    <div class="popup user-data-popup">
      <div class="page">
        <div class="navbar">
          <div class="navbar-bg"></div>
          <div class="navbar-inner">
            <div class="title">New Product</div>
            <div class="right">
              <!-- Close button -->
              <a class="link popup-close">Close</a>
            </div>
          </div>
        </div>

        <div class="page-content">
          <form class="list" id="tab-user-form">
            <ul>
              <li class="item-content item-input">
                <div class="item-inner">
                  <div class="item-title item-label">Phone</div>
                  <div class="item-input-wrap">
                    <input type="tel" name="phone" placeholder="12345678 (if not set uses the default)" validate
                      pattern="[0-9]{8}" autocomplete="tel" />
                    <span class="input-clear-button"></span>
                  </div>
                </div>
              </li>

              <li class="item-content item-input">
                <div class="item-inner">
                  <div class="item-title item-label">Name</div>
                  <div class="item-input-wrap">
                    <input type="text" name="name" placeholder="My Product to sell" required validate />
                    <span class="input-clear-button"></span>
                  </div>
                </div>
              </li>

              <li class="item-content item-input">
                <div class="item-inner">
                  <div class="item-title item-label">Price</div>
                  <div class="item-input-wrap">
                    <input type="tel" name="price" placeholder="₡0.00" inputmode="decimal" required validate />
                    <span class="input-clear-button"></span>
                  </div>
                </div>
              </li>

              <li class="item-content item-input">
                <div class="item-inner">
                  <div class="item-title item-label">Detail</div>
                  <div class="item-input-wrap">
                    <input type="text" name="detail" placeholder="A description" validate />
                    <span class="input-clear-button"></span>
                  </div>
                </div>
              </li>



            </ul>

            <div class="block">
              <button type="button" class="button button-fill" @click="${submitForm}">
                Save Information
              </button>
            </div>
          </form>
        </div>
      </div>
    </div>

    <!-- Views/Tabs container -->
    <div class="views tabs safe-areas">
      <!-- Tabbar for switching views-tabs -->
      <div class="toolbar tabbar toolbar-bottom tabbar-icons">
        <div class="toolbar-inner">
          <div class="toolbar-pane">
            <a href="#view-home" class="tab-link">
              <i class="icon f7-icons if-not-md">house_fill</i>
              <i class="icon material-icons if-md">home</i>
              <span class="tabbar-label">${i18next.t('home')}</span>
            </a>

            <a href="#view-codes" class="tab-link">
              <i class="icon f7-icons if-not-md">qrcode</i>
              <i class="icon material-icons if-md">qr_code</i>
              <span class="tabbar-label">${i18next.t('codes')}</span>
            </a>

            <a href="#view-read" class="tab-link tab-link">
              <i class="icon f7-icons if-not-md">camera_circle_fill</i>
              <i class="icon material-icons if-md">photo_camera</i>
              <span class="tabbar-label">${i18next.t('read')}</span>
            </a>


            <a href="#view-history" class="tab-link">
              <i class="icon f7-icons if-not-md">clock</i>
              <i class="icon material-icons if-md">history</i>
              <span class="tabbar-label">${i18next.t('history')}</span>
            </a>

            <!-- <a href="#view-settings" class="tab-link">
              <i class="icon f7-icons if-not-md">gear</i>
              <i class="icon material-icons if-md">settings</i>
              <span class="tabbar-label">Settings</span>
            </a> -->
          </div>
        </div>
      </div>

      <!-- Your main view/tab, should have "view-main" class. It also has "tab-active" class -->
      <div id="view-home" class="view view-main view-init tab" data-url="/">
        <!-- Home page will be loaded here dynamically from / route -->
      </div>

      <!-- Codes View -->
      <div id="view-codes" class="view view-init tab" data-name="codes" data-url="/codes/">
        <!-- codes page will be loaded here dynamically from /codes/ route -->
      </div>

      <!-- Read view -->
      <div id="view-read" class="view view-init tab" data-url="/read/">
        <!-- Read page will be loaded here dynamically from / route -->
      </div>

      <!-- History View -->
      <div id="view-history" class="view view-init tab" data-name="history" data-url="/history/">
        <!-- History page will be loaded here dynamically from /history/ route -->
      </div>

      <!-- Settings View -->
      <!-- <div id="view-settings" class="view view-init tab" data-name="settings" data-url="/settings/"> -->
      <!-- Settings page will be loaded here dynamically from /settings/ route -->
      <!-- </div> -->



    </div>


    <!-- Popup -->
    <div class="popup" id="my-popup">
      <div class="view">
        <div class="page">
          <div class="navbar">
            <div class="navbar-bg"></div>
            <div class="navbar-inner">
              <div class="title">Popup</div>
              <div class="right">
                <a href="#" class="link popup-close">Close</a>
              </div>
            </div>
          </div>
          <div class="page-content">
            <div class="block">
              <p>Popup content goes here.</p>
            </div>
          </div>
        </div>
      </div>
    </div>

  </div>
</template>
<script>
  import i18next from 'i18next';
  import { getOption, Keys } from 'db';
  export default (props, { $f7, $update, $on, $el, $store }) => {
    $f7.on('init', async _ => {
      const pageIndexToLoad = await getOption(Keys.PAGE_TO_LOAD, 0);
      const tab = document.querySelectorAll('div.view-init')[pageIndexToLoad];
      const tabLink = document.querySelectorAll('.tab-link')[pageIndexToLoad];
      $f7.tab.show(`#${tab.id}`, tabLink, true);
    });


    const submitForm = () => {
      // Extract data using Framework7 form helper
      const formData = $f7.form.convertToData('#tab-user-form');

      if (!formData.name || !formData.price) {
        $f7.dialog.alert('Please fill out all fields.');
        return;
      }

      console.log('Submitted Data:', formData);

      $store.dispatch('addProduct', formData);


      // Close the popup programmatically
      $f7.popup.close('.user-data-popup');

      // Show confirmation
      $f7.toast.create({
        text: 'Form submitted successfully!',
        closeTimeout: 2000,
      }).open();
    };


    return $render;
  }
</script>