            <a href="#view-read" class="tab-link tab-link">
              <i class="icon f7-icons if-not-md">camera_circle_fill</i>
              <i class="icon material-icons if-md">photo_camera</i>
              <span class="tabbar-label">${i18next.t('read')}</span>
