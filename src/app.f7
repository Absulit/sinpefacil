      <!-- Your main view/tab, should have "view-main" class. It also has "tab-active" class -->
      <!-- <div id="view-home" class="view view-main view-init tab" data-name="home" data-url="/"> -->
      <!-- Home page will be loaded here dynamically from / route -->
      <!-- </div> -->

      <!-- Codes View -->
      <div id="view-codes" class="view view-main view-init tab" data-name="codes" data-url="/codes/">
        <!-- codes page will be loaded here dynamically from /codes/ route -->
      </div>

      <!-- Read view -->
      <div id="view-read" class="view view-init tab" data-name="read" data-url="/read/">
        <!-- Read page will be loaded here dynamically from / route -->
      </div>

      <!-- History View -->
      <div id="view-history" class="view view-init tab" data-name="history" data-url="/history/">
        <!-- History page will be loaded here dynamically from /history/ route -->
      </div>

      <!-- Settings View -->
      <!-- <div id="view-settings" class="view view-init tab" data-name="settings" data-url="/settings/"> -->
      <!-- Settings page will be loaded here dynamically from /settings/ route -->
      <!-- </div> -->



    </div>


    <!-- Popup -->
    <div class="popup" id="my-popup">
      <div class="view">
        <div class="page">
          <div class="navbar">
            <div class="navbar-bg"></div>
            <div class="navbar-inner">
              <div class="title">Popup</div>
              <div class="right">
                <a href="#" class="link popup-close">Close</a>
              </div>
            </div>
          </div>
          <div class="page-content">
            <div class="block">
              <p>Popup content goes here.</p>
            </div>
          </div>
        </div>
      </div>
    </div>

  </div>
</template>
<script>
  import i18next from 'i18next';
  import { isUnicode } from 'sms'
  import { getOption, Keys, getPhone, saveOption } from 'db';
  import { strLen } from 'i18n';
  let numChars = 5;
  const SMS_START = 'PASE ';

  function cleanTextAndLength(smsStartText, inputs) {
    let smsText = smsStartText;
    inputs.forEach(input => smsText += input.value + ' ');
    smsText = smsText.trim().replace(/\s+/g, ' ');
    numChars = strLen(smsText);
    return { smsText, numChars }
  }

  export default (props, { $f7, $update, $on, $el, $store }) => {
    let productId = null;
    let currentProduct = null;
    $f7.on('init', async _ => {
      const pageIndexToLoad = await getOption(Keys.PAGE_TO_LOAD, 0);
      const tab = document.querySelectorAll('div.view-init')[pageIndexToLoad];
      const tabLink = document.querySelectorAll('.tab-link')[pageIndexToLoad];
      $f7.tab.show(`#${tab.id}`, tabLink, true);

      const firtTime = await getOption(Keys.FIRST_TIME, true);
      if (firtTime) {
        $f7.views.current.router.navigate('/about/')
        await saveOption(Keys.FIRST_TIME, false);
      }
    });

    $f7.on('openQRDataPopup', async (id = null) => {
      console.log('---- POP UP OPEN PRODUCT');
      const form = $f7.$('#qr-data-form')[0];
      const inputs = Array.from(form.querySelectorAll('input'));
      const smsexample = document.getElementById('smsexample');
      const phoneInput = form.querySelector('#phone');
      const phoneDB = await getPhone();
      if (phoneDB) {
        phoneInput.placeholder = phoneDB.number;
        phoneInput.required = false;
      }

      productId = id;
      currentProduct = null;
      
      if (productId) {
        const products = $store.getters.products;
        products.value.forEach(product => {
          if (product.id !== productId) {
            return;
          }
          currentProduct = product;
        });

        $f7.form.fillFromData('#qr-data-form', currentProduct);
      } else {
        form.reset();
      }

      const formName = form.elements['name'];
      const formDetail = form.elements['detail'];
      const formPhone = form.elements['phone'];

      let phone = formPhone.value.length ? '' : phoneDB?.number ?? '';
      const { smsText, numChars } = cleanTextAndLength(SMS_START + phone, inputs);
      smsexample.innerText = smsText;
      console.log(smsText, numChars);


      // Re-render popup UI with updated state before opening
      $update();
      $f7.popup.open('.qr-data-popup');



      form.addEventListener('input', e => {

        let phone = formPhone.value.length ? '' : phoneDB?.number ?? '';
        const { smsText, numChars } = cleanTextAndLength(SMS_START + phone, inputs);

        const hasUnicode = isUnicode(smsText);
        smsexample.innerText = smsText;

        // check validity of length and unicode
        const maxLength = hasUnicode ? 70 : 160;
        formName.setCustomValidity('');
        formDetail.setCustomValidity('');

        if (numChars > maxLength) {
          formName.setCustomValidity(`Excede el límite total de ${maxLength} caracteres (${numChars})`);
          formDetail.setCustomValidity(`Excede el límite total de ${maxLength} caracteres (${numChars})`);
        }

        $update();
      });

    });

    const submitForm = () => {
      // Extract data using Framework7 form helper
      const form = $f7.$('#qr-data-form')[0];
      const formData = $f7.form.convertToData('#qr-data-form');

      if (!form.reportValidity()) {
        return;
      }

      console.log('Submitted Data:', formData);
      console.log('---- currentProduct:', currentProduct);

      if (currentProduct) {
        const { id } = currentProduct;
        const productUpdated = { ...formData, id };
        $store.dispatch('updateProduct', productUpdated);
        $f7.emit('PRODUCT_UPDATED', productUpdated);

      } else {
        $store.dispatch('addProduct', formData);
      }

      currentProduct = null;

      // Close the popup programmatically
      $f7.popup.close('.qr-data-popup');

      // Show confirmation
      $f7.toast.create({
        text: 'Producto creado',
        closeTimeout: 2000,
      }).open();
    };

    return $render;
  }
</script>