<template>
  <div class="page" data-name="product">
    <div class="navbar">
      <div class="navbar-bg"></div>
      <div class="navbar-inner sliding">
        <div class="left">
          <a href="#" class="link back">
            <i class="icon icon-back"></i>
          </a>
        </div>
        <div class="title">${currentHistoryItem.name}</div>

        <div class="right">
          <!-- Share QR -->
          <a href="#" class="link icon-only popup-open" @click="${resend}">
            <i class="icon f7-icons if-not-md">paperplane_fill</i>
            <i class="icon material-icons if-md">send</i>
          </a>
          <!-- Share QR -->
          <a href="#" class="link icon-only popup-open" @click="${share}">
            <i class="icon f7-icons if-not-md">square_arrow_up</i>
            <i class="icon material-icons if-md">share</i>
          </a>
          <!-- Overflow / More Menu -->
          <a href="#" class="link icon-only popover-open" data-popover=".popover-menu">
            <i class="f7-icons">ellipsis_vertical</i>
          </a>
        </div>



      </div>
    </div>

    <!-- Popover for the 3-dot overflow menu -->
    <div class="popover popover-menu">
      <div class="popover-inner">
        <div class="list">
          <ul>
            <li><a href="#" class="list-button popover-close" @click=${()=>deleteProduct()}>${i18next.t('delete')}</a>
            </li>
            <li><a href="#" class="list-button popover-close" @click=${()=>printProduct()}>${i18next.t('print')}</a>
            </li>
          </ul>
        </div>
      </div>
    </div>

    <div class="page-content">

      <div class="card card-raised print-area">
        <div class="card-header">${currentHistoryItem.name}</div>
        <div class="card-content card-content-padding">

          <div id="qr-code-container" class="block text-align-center"></div>
        </div>
        <div class="card-content card-content-padding">
          <div class="card-content-padding">
            <p>
              ${currentHistoryItem.phone}
            </p>
            <p>
              ${currentHistoryItem.detail ? $h`${currentHistoryItem.detail}` : '<Sin descripción>'}
            </p>
          </div>
        </div>
        <div class="card-footer">
          <span class="date">${formatDate(currentHistoryItem.createdAt)}</span><span>₡${currentHistoryItem.price}</span>
        </div>
      </div>

    </div>

  </div>
</template>
<script>

  import QRCodeStyling from 'qr-code-styling';
  import shareLink, { createURL } from 'share';
  import { getPhone, getOption, Keys, db } from 'db';
  import { formatDate } from 'i18n';
  import generateSINPESMS, { validateSMS, SMS_START } from 'sms';
  import i18next from 'i18next';
  export default (props, { $f7, $f7route, $store, $on, $el, $update }) => {
    const history = $store.getters.history;
    const historyItemId = +$f7route.params.id;
    let currentHistoryItem;
    history.value.forEach(historyItem => {
      if (historyItem.id !== historyItemId) {
        return;
      }
      currentHistoryItem = historyItem;
    });

    $on('pageInit', async () => {
      const { phone, name, price, detail } = currentHistoryItem;

      const url = createURL(phone, name, price, detail);

      const qrCode = new QRCodeStyling({
        width: 300,
        height: 300,
        type: 'svg',
        data: url,
        image: '', // link to image
        dotsOptions: {
          color: '#ff5500',
          type: 'square'
        },
        backgroundOptions: {
          color: '#e9ebee',
        },
        imageOptions: {
          crossOrigin: 'anonymous',
          margin: 20
        }
      });

      const container = $el.value.find('#qr-code-container')[0];
      qrCode.append(container);
      // qrCode.download({ name: "qr", extension: "svg" });
    })

    const deleteProduct = () => {
      $f7.dialog.confirm(`Desea borrar '${currentHistoryItem.name}'?`, () => {
        $f7.preloader.show();
        // TODO: verify if delete was successful
        $store.dispatch('deleteHistoryItem', currentHistoryItem.id);
        $store.dispatch('initApp');
        $f7.preloader.hide();
        $f7.views.current.router.back('/history/', { force: true });

        $f7.toast.create({
          text: 'Recibo borrado',
          closeTimeout: 2000,
        }).open();
      });
    }

    const printProduct = () => {
      window.print();
    }

    const share = async () => {
      const { phone, name, price, detail } = currentHistoryItem;
      const url = createURL(phone, name, price, detail);

      shareLink($f7, `
      ${name}
      ${phone}
      ${price}
      ${detail}
      `.trim().replace(/^ +/gm, ''), url)
    }

    const resend = async () => {
      const bankId = await getOption(Keys.SELECTED_BANK);
      const bank = await db.banks.get(bankId);
      const { price, phone, name, detail } = currentHistoryItem;

      const isValid = validateSMS(SMS_START, price, phone, name, detail);
      if (!isValid) {
        $f7.dialog.confirm(i18next.t('validation:linkLength'), 'SINPE Fácil')
        return;
      }

      await $store.dispatch('addHistoryItem', { price, phone, name, detail, createdAt: new Date() })
      window.location.href = generateSINPESMS(bank.phone, price, phone, name, detail);
    }

    return $render;
  };
</script>