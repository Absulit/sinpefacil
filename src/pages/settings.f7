<template>
  <div class="page" data-name="settings">
    <div class="navbar">
      <div class="navbar-bg"></div>
      <div class="navbar-inner sliding">
        <div class="left">
          <a href="#" class="link back" @click="${handleBack}">
            <i class="icon icon-back"></i>
          </a>
        </div>
        <div class="title">Ajustes</div>
      </div>
    </div>
    <div class="page-content">
      <div class="list list-strong-ios list-dividers-ios list-outline-ios">
        <ul>

          <li>
            <div class="item-content item-input">
              <div class="item-inner">
                <div class="item-title item-label">Teléfono</div>
                <div class="item-input-wrap">
                  <input type="tel" placeholder="Teléfono" />
                </div>
              </div>
            </div>
          </li>
          <li>

            <a class="item-link smart-select smart-select-init">
              <select id="banks" name="banks">
                <!-- <option value="apple" selected>Apple</option> -->
              </select>
              <div class="item-content">
                <div class="item-inner">
                  <div class="item-title">Banco</div>
                </div>
              </div>
            </a>

          </li>

          <li>
            <div class="item-content">
              <div class="item-inner">
                <div class="item-title">Forzar Idioma</div>
                <div class="item-after">
                  <label class="toggle toggle-init">
                    <input type="checkbox" />
                    <span class="toggle-icon"></span>
                  </label>
                </div>
              </div>
            </div>

            <div class="item-content item-input">
              <div class="item-inner">
                <div class="item-input-wrap">
                  <select disabled>
                    <option>Inglés</option>
                    <option>Español</option>
                  </select>
                </div>
              </div>
            </div>
          </li>



        </ul>
      </div>


    </div>
  </div>
</template>
<script>
  import { db, getOption, saveOption, Keys } from 'db';
  import generateSINPESMS from 'sms';
  import { clearParams } from 'url';
  export default async (props, { $f7, $on, $f7route }) => {

    // this means the user received a link to pay, but doesn't have defined bank
    let linkShared = null
    $on('pageInit', async () => {
      const banks = await db.banks.toArray();
      console.log(banks);

      const { phone, name, price, detail } = $f7route.query;
      linkShared = phone && name && price && detail;
      if (linkShared) {
        $f7.toolbar.hide('.toolbar');
      }

      let values = [];
      let displayValues = [];

      banks.forEach(bank => {
        values.push(bank.id);
        displayValues.push(bank.name);
      });

      let bankId = await getOption(Keys.SELECTED_BANK);

      const banksSelect = document.getElementById('banks');
      banks.forEach(bank => {
        const option = new Option(bank.name, bank.id, bankId === bank.id)
        banksSelect.append(option);
        console.log(option);

      })
      banksSelect.addEventListener('change', e => {
        console.log(e.target.value);
        saveOption(Keys.SELECTED_BANK, +e.target.value);
      })
      banksSelect.dispatchEvent(new Event('change', { bubbles: true }));

      banksSelect.parentNode.addEventListener('click', e => {
        console.log('open');
        $f7.toolbar.hide('.toolbar');
      })
    })




    const handleBack = async () => {
      const bankId = await getOption(Keys.SELECTED_BANK)
      if (!bankId) {
        $f7.dialog.confirm(
          'No ha seleccionado su banco. Salir? ',
          () => {// ok
            const tabLink = document.querySelectorAll('.tab-link')[0]
            $f7.tab.show(`#view-home`, tabLink, true);
          },
          () => { // cancel
            $f7.views.current.router.navigate('/settings/')
          }
        );
      } else {
        // before we exit we need to generate the SMS for the link shared
        if (linkShared) {
          const bank = await db.banks.get(bankId);
          const { phone, name, price, detail } = $f7route.query;
          clearParams();
          generateSINPESMS(bank.phone, price, phone, name, detail);
        }

        $f7.views.current.router.back()
        $f7.toolbar.show('.toolbar');
      }
    };





    return $render;
  };
</script>