<template>
  <div class="page" data-name="settings">
    <div class="navbar">
      <div class="navbar-bg"></div>
      <div class="navbar-inner sliding">
        <div class="left">
          <a href="#" class="link back" @click="${handleBack}">
            <i class="icon icon-back"></i>
          </a>
        </div>
        <div class="title">${i18next.t('settings')}</div>
      </div>
    </div>
    <div class="page-content">
      <div class="list list-strong-ios list-dividers-ios list-outline-ios">
        <ul>

          <li>
            <div class="item-content item-input">
              <div class="item-inner">
                <div class="item-title item-label">${i18next.t('settings:phone')}</div>
                <div class="item-input-wrap">
                  <input id="phoneInputSettings" maxlength="8" minlength="8" type="text" inputmode="numeric"
                    pattern="[0-9]{8}" validate placeholder="${i18next.t('settings:phonePlaceholder')}" required />
                </div>
              </div>
            </div>
          </li>

          <li>
            <a class="item-link smart-select smart-select-init" data-browser-history="true" data-open-in="page"
              data-name="select-bank">
              <select id="banksSelect" name="banksSelect">
                <!-- <option value="apple" selected>Apple</option> -->
              </select>
              <div class="item-content">
                <div class="item-inner">
                  <div class="item-title">${i18next.t('settings:bank')}</div>
                </div>
              </div>
            </a>
          </li>

          <li>
            <div class="item-content">
              <div class="item-inner">
                <div class="item-title">${i18next.t('settings:lang')}</div>
                <div class="item-after">
                  <label class="toggle toggle-init">
                    <input id="langInput" type="checkbox" />
                    <span class="toggle-icon"></span>
                  </label>
                </div>
              </div>
            </div>

            <div class="item-content item-input">
              <div class="item-inner">
                <div class="item-input-wrap">
                  <select id="langSelect" disabled></select>
                </div>
              </div>
            </div>
          </li>

        </ul>
      </div>


    </div>
  </div>
</template>
<script>
  import { db, savePhone, getPhone, getBankId, saveBankId, getOption, saveOption, Keys } from 'db';
  import i18next from 'i18next';
  import { LangEvent } from 'events';
  import { navigatorLanguage, getLanguageName } from 'i18n';
  export default async (props, { $f7, $on, $f7route, $update }) => {

    let phoneInput;
    $on('pageInit', async () => {
      const banks = await db.banks.toArray();
      const { phone, name, price, detail } = $f7route.query;
      let bankId = await getBankId();
      const banksSelect = document.getElementById('banksSelect');

      banks.forEach(bank => {
        const option = new Option(bank.name, bank.id, bankId === bank.id)
        banksSelect.append(option);
      })
      banksSelect.value = bankId;
      banksSelect.addEventListener('change', async e => {
        await saveBankId(+e.target.value);
      })
      banksSelect.dispatchEvent(new Event('change', { bubbles: true }));

      phoneInput = document.getElementById('phoneInputSettings');

      const dbPhone = await getPhone();

      if (dbPhone) {
        phoneInput.value = dbPhone.number;
      }

      const numericValidationRegex = /[^0-9]/g
      phoneInput.addEventListener('input', async e => {
        phoneInput.setCustomValidity('')
        if (numericValidationRegex.test(phoneInput.value)) {
          phoneInput.setCustomValidity(i18next.t('settings:phoneValidity'))
        }
        phoneInput.value = phoneInput.value.replace(numericValidationRegex, '')
      })


      ////////////////////
      const langInput = document.getElementById('langInput');
      const langSelect = document.getElementById('langSelect');

      const loadedLanguages = Object.keys(i18next.services.resourceStore.data)

      const lang = await getOption(Keys.LANG, 'es');
      langInput.checked = await getOption(Keys.FORCE_LANG, false);
      loadedLanguages.forEach(code => {
        const option = new Option(getLanguageName(code), code, code === lang)
        langSelect.append(option);
      })
      langSelect.value = lang;
      langSelect.dispatchEvent(new Event('change', { bubbles: true }));
      langSelect.disabled = !langInput.checked;

      langInput.addEventListener('change', async e => {
        const disabled = !e.target.checked;
        langSelect.disabled = disabled;
        let code = langSelect.value;
        await saveOption(Keys.FORCE_LANG, !disabled);

        if (disabled) {
          code = navigatorLanguage();
        }
        await saveOption(Keys.LANG, code);
        await i18next.changeLanguage(code);
        $update();
        $f7.emit(LangEvent.LANG_UPDATED);
      })

      langSelect.addEventListener('change', async e => {
        const code = e.target.value;
        await saveOption(Keys.LANG, code);
        await i18next.changeLanguage(code);
        $update();
        $f7.emit(LangEvent.LANG_UPDATED);
      })
      ////////////////////

    })

    const handleBack = async () => {

      // if phone is valid and is not the same as what it already exists
      // we save it and show toast
      // This is mostly to not show the SAVED toast
      if (phoneInput.checkValidity()) {
        const dbPhone = await getPhone();
        const newNumber = +phoneInput.value;

        if (+dbPhone?.number !== newNumber) {
          savePhone(newNumber);
          $f7.toast.create({
            text: i18next.t('settings:phoneSaved'),
            closeTimeout: 2000,
          }).open();
        }
      } else {

        $f7.toast.create({
          text: i18next.t('settings:phoneNotSaved'),
          closeTimeout: 2000,
        }).open();

      }

      const bankId = await getBankId();
      if (!bankId) {
        $f7.dialog.confirm(
          i18next.t('settings:CTAselectBank'),
          () => {// ok
            $f7.views.current.router.back();
          },
          () => { // cancel
            $f7.views.current.router.navigate('/settings/')
          }
        );
      } else {
        $f7.views.current.router.back()
        $f7.toolbar.show('.toolbar');
      }
    };

    $on('pageAfterOut', (e, page) => {
      $f7.emit('RESTART_CAM')
    });

    return $render;
  };
</script>