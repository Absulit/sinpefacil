<template>
  <div class="page" data-name="home">
    <!-- Top Navbar -->
    <div class="navbar">
      <div class="navbar-bg"></div>
      <div class="navbar-inner">
        <!-- <div class="left">
          <a href="#" class="link icon-only panel-open" data-panel="left">
            <i class="icon f7-icons if-not-md">menu</i>
            <i class="icon material-icons if-md">menu</i>
          </a>
        </div> -->
        <div class="title sliding ">SINPE Fácil</div>
        <div class="right">
          <a href="/settings/" class="link icon-only" data-name="settings" data-url="/settings/">
            <i class="icon f7-icons if-not-md">gear_alt_fill</i>
            <i class="icon material-icons if-md">settings</i>
          </a>
        </div>
        <!-- <div class="title-large">
          <div class="title-large-text">SINPE Fácil</div>
        </div> -->
      </div>
    </div>

    <!-- Scrollable page content-->
    <div class="page-content">
      <div class="block">
        <p>
          ${i18next.t('home:aboutContent')}
        </p>

      </div>
      <div class="block">
        <div class="block-title">${i18next.t('home:selectScreen')}:</div>
        <p>
          ${i18next.t('home:selectScreenContent')}
        </p>


        <div class="segmented segmented-strong">
          <button class="button ${activeStrongButton===0 ? 'button-active' : '' }"
            @click=${()=>setStrongButton(0)}>${i18next.t('home')}</button>
          <button class="button ${activeStrongButton===1 ? 'button-active' : '' }"
            @click=${()=>setStrongButton(1)}>${i18next.t('codes')}</button>
          <button class="button ${activeStrongButton===2 ? 'button-active' : '' }"
            @click=${()=>setStrongButton(2)}>${i18next.t('read')}</button>
          <span class="segmented-highlight"></span>
        </div>
      </div>

      <div class="block">
        <button id="install" class="button button-raised button-fill display-none">Instalar en teléfono</button>
      </div>

      <div class="block">
        ${i18next.t('credits')} <a class="external" target="_blank" href="https://mastodon.social/@absulit">@absulit</a>
      </div>

    </div>
  </div>
</template>
<script>
  import i18next from 'i18next';
  import { getOption, saveOption, Keys } from 'db';
  export default async (props, { $f7, $update, $on }) => {

    $on('pageInit', async () => {


      let installPrompt = null;
      const installButton = document.querySelector("#install");

      window.addEventListener("beforeinstallprompt", (event) => {
        event.preventDefault();
        installPrompt = event;
        installButton.classList.remove('display-none');
      });

      window.addEventListener("appinstalled", () => {
        disableInAppInstallPrompt();
      });

      installButton.addEventListener("click", async () => {
        if (!installPrompt) {
          return;
        }
        const result = await installPrompt.prompt();
        console.log(`Install prompt was: ${result.outcome}`);
        disableInAppInstallPrompt();
      });

      function disableInAppInstallPrompt() {
        installPrompt = null;
        installButton.classList.add('display-none');
      }
    })

    const pageIndexToLoad = await getOption(Keys.PAGE_TO_LOAD, 0);
    let activeStrongButton = pageIndexToLoad;

    const setStrongButton = index => {
      activeStrongButton = index;
      saveOption(Keys.PAGE_TO_LOAD, index);
      $update();
    }
    return $render;
  }
</script>