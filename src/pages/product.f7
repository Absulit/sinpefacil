<template>
  <div class="page" data-name="product">
    <div class="navbar">
      <div class="navbar-bg"></div>
      <div class="navbar-inner sliding">
        <div class="left">
          <a href="#" class="link back">
            <i class="icon icon-back"></i>
          </a>
        </div>
        <div class="title">${currentProduct.name}</div>

        <div class="right">
          <!-- Edit QR -->
          <a href="#" class="link icon-only popup-open" @click="${() => $f7.emit(ProductEvent.ADD, currentProduct.id)}"
            id="btn-pin">
            <i class="f7-icons">pencil</i>
          </a>
          <!-- Share QR -->
          <a href="#" class="link icon-only popover-open" data-popover=".popover-menu-share">
            <i class="icon f7-icons if-not-md">square_arrow_up</i>
            <i class="icon material-icons if-md">share</i>
          </a>
          <!-- Overflow / More Menu -->
          <a href="#" class="link icon-only popover-open" data-popover=".popover-menu">
            <i class="f7-icons">ellipsis_vertical</i>
          </a>
        </div>



      </div>
    </div>

    <!-- Popover for share -->
    <div class="popover popover-menu-share">
      <div class="popover-inner">
        <div class="list media-list no-hairlines">
          <ul>
            <li>
              <a href="#" class="item-link item-content popover-close" @click=${()=>shareToImage()}>

                <div class="item-media">
                  <i class="icon f7-icons if-not-md">photo</i>
                  <i class="icon material-icons if-md">image</i>
                </div>
                <div class="item-inner">
                  <div class="item-title">${i18next.t('image')}</div>
                </div>

              </a>
            </li>
            <li>
              <a href="#" class="item-link item-content popover-close" @click=${()=>share()}>

                <div class="item-media">
                  <i class="icon f7-icons if-not-md">link</i>
                  <i class="icon material-icons if-md">link</i>
                </div>
                <div class="item-inner">
                  <div class="item-title">${i18next.t('link')}</div>
                </div>

              </a>
            </li>
          </ul>
        </div>
      </div>
    </div>

    <!-- Popover for the 3-dot overflow menu -->
    <div class="popover popover-menu">
      <div class="popover-inner">
        <div class="list">
          <ul>
            <li><a href="#" class="list-button popover-close" @click=${()=>deleteProduct()}>${i18next.t('delete')}</a>
            </li>
            <li><a href="#" class="list-button popover-close" @click=${()=>printProduct()}>${i18next.t('print')}</a>
            </li>
          </ul>
        </div>
      </div>
    </div>

    <div class="page-content">

      <div class="card card-raised">
        <div class="card-header">${currentProduct.name}</div>
        <div class="card-content card-content-padding">

          <div id="qr-code-container" class="block text-align-center print-area margin-top-half"></div>
        </div>

        <div class="card-content card-content-padding">

          <div class="card-content-padding">
            <div class="grid grid-cols-2 grid-gap">
              <div>
                <div class="text-color-gray text-transform-uppercase margin-bottom-half">
                  <i class="icon f7-icons if-not-md">phone_fill</i>
                  <i class="icon material-icons if-md">phone</i>
                  <span>
                    ${finalPhone}
                  </span>
                </div>

                <div class="display-1 text-color-primary weight-bold margin-bottom">
                  <i class="icon f7-icons if-not-md">tag_fill</i>
                  <i class="icon material-icons if-md">local_offer</i>
                  <span class="date"></span><span>₡${currentProduct.price}</span>
                </div>


              </div>

              <div>
                <div class="text-color-gray text-transform-uppercase margin-bottom">
                  <i class="icon f7-icons if-not-md">doc_text_fill</i>
                  <i class="icon material-icons if-md">description</i>
                  <span>
                    ${currentProduct.detail ? $h`${currentProduct.detail}` : '<Sin descripción>'}
                  </span>
                </div>
              </div>
            </div>








            <div class="block block-strong text-align-center">
              <div class="gauge gauge-init" data-type="semicircle" data-value="0" data-value-text=""
                data-value-text-color="#007aff" data-value-font-size="32" data-value-font-weight="bold"
                data-border-color="#007aff" data-border-width="10" data-label-text="OTP">
              </div>
            </div>

          </div>
        </div>
      </div>

    </div>

  </div>
</template>
<script>

  import QRCodeStyling from 'qr-code-styling';
  import shareLink, { createURL, shareImage, svg2png } from 'share';
  import { getPhone, getLogo } from 'db';
  import { formatDate } from 'i18n';
  import i18next from 'i18next';
  import { ProductEvent } from 'events';
  import { styleOptions, defaultImage } from 'qrcode';
  import { readAsDataURL } from 'file';
  import { timerStart, timerStop, DURATION_MILLISECONDS, generatePIN } from 'timer';
  import { generateSalt, deriveKey, encrypt, decrypt } from 'crypto';

  function onVisibilityChange(e) {
    if (!document.hidden) {
    }
  }

  async function createQRCode(currentProduct, container, pin) {
    const { phone, name, price, detail } = currentProduct;

    let finalPhone = phone;
    if (!phone) {
      const phoneDB = await getPhone();
      finalPhone = phoneDB.number;
    }

    const url = await createURL(finalPhone, name, price, detail, pin);

    styleOptions.data = url;
    const logoImage = await getLogo();
    styleOptions.image = defaultImage;
    if (logoImage) {
      styleOptions.image = logoImage;
    }
    const qrCode = new QRCodeStyling(styleOptions);

    container.innerText = '';
    qrCode.append(container);

    return finalPhone;
  }

  export default (props, { $f7, $f7route, $store, $on, $el, $update }) => {
    const products = $store.getters.products;
    const productId = +$f7route.params.id;
    let currentProduct;
    let pinProgressValue = 0;
    let gauge = null;
    let finalPhone = null;
    let qrContainer = null;
    let pin = null;
    products.value.forEach(product => {
      if (product.id !== productId) {
        return;
      }
      currentProduct = product;
    });



    $on('pageInit', async page => {
      qrContainer = $el.value.find('#qr-code-container')[0];

      gauge = $f7.gauge.create({
        el: '.gauge',
        type: 'semicircle',
        value: 1,
        borderColor: '#007aff',
        borderWidth: 10,
        valueText: '',
        valueFontSize: 32,
        valueTextColor: '#007aff',
        labelText: 'PIN',
      });

      await timerStart(async () => { // start
        pin = generatePIN()

        gauge.update({ valueText: pin });
        finalPhone = await createQRCode(currentProduct, qrContainer, pin);

      }, async (remainingMilliseconds, secondsLeft) => { // update
        // console.log(remainingMilliseconds, secondsLeft);
        pinProgressValue = (remainingMilliseconds / DURATION_MILLISECONDS) * 100;
        gauge.update({ value: pinProgressValue / 100 });


      });


      document.addEventListener('visibilitychange', onVisibilityChange);
      $update();
    })


    $f7.on(ProductEvent.UPDATED, async productUpdated => {
      currentProduct = productUpdated;
      finalPhone = await createQRCode(currentProduct, qrContainer);
      $update();
    })

    $on('pageBeforeRemove', () => {
      document.removeEventListener('visibilitychange', onVisibilityChange);
      $f7.off(ProductEvent.UPDATED);
      timerStop();
    });

    const deleteProduct = () => {
      const { id, name } = currentProduct;
      $f7.dialog.confirm(i18next.t('codes:CTADelete', { name }), async () => {

        $f7.preloader.show();
        // TODO: verify if delete was successful
        await $store.dispatch('deleteProduct', id);
        await $store.dispatch('initApp');
        $f7.preloader.hide();
        $f7.views.current.router.back('/codes/', { force: true });

        $f7.toast.create({
          text: i18next.t('codes:deleteConfirmation'),
          closeTimeout: 2000,
        }).open();
      });
    }

    const printProduct = () => {
      window.print();
    }

    const share = async () => {
      const { phone, name, price, detail } = currentProduct;
      let finalPhone = phone;
      if (!phone) {
        const phoneDB = await getPhone();
        finalPhone = phoneDB.number;
      }

      const url = await createURL(finalPhone, name, price, detail, pin);

      shareLink($f7, `
      ${name}
      ${finalPhone}
      ${price}
      ${detail}
      `.trim().replace(/^ +/gm, ''),
        url)
    }

    const shareToImage = async () => {
      const { phone, name, price, detail } = currentProduct;
      let finalPhone = phone;
      if (!phone) {
        const phoneDB = await getPhone();
        finalPhone = phoneDB.number;
      }

      const svg = $el.value.find('#qr-code-container')[0].firstElementChild;

      const serializer = new XMLSerializer();
      let svgString = serializer.serializeToString(svg);

      const dataUrl = await svg2png(svgString);
      const response = await fetch(dataUrl);
      const blob = await response.blob();

      const generatedWith = i18next.t('share:generatedWith', { site: 'app.sinpefacil.com' });

      shareImage($f7, `
      ${name}
      ${finalPhone}
      ${price}
      ${detail}

      ${generatedWith}
      `.trim().replace(/^ +/gm, ''),
        blob
      )
    }

    return $render;
  };
</script>