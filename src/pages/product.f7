<template>
  <div class="page" data-name="product">
    <div class="navbar">
      <div class="navbar-bg"></div>
      <div class="navbar-inner sliding">
        <div class="left">
          <a href="#" class="link back">
            <i class="icon icon-back"></i>
          </a>
        </div>
        <div class="title">${currentProduct.name}</div>
      </div>
    </div>

    <div class="fab fab-right-bottom">
      <a>
        <i class="icon f7-icons if-not-md">plus</i>
        <i class="icon f7-icons if-not-md">xmark</i>
        <i class="icon material-icons md-only">add</i>
        <i class="icon material-icons md-only">close</i>
      </a>
      <div class="fab-buttons fab-buttons-top">
        <a href="" class="fab-label-button">
          <span>1</span>
          <span class="fab-label">Editar</span>
        </a>
        <a href="" class="fab-label-button">
          <span>2</span>
          <span class="fab-label">Imprimir</span>
        </a>
        <a href="" class="fab-label-button">
          <span>3</span>
          <span class="fab-label">Borrar</span>
        </a>
      </div>
    </div>


    <div class="page-content">
      <div class="block-title">${currentProduct.name}</div>
      <div class="block">
        <ul>
          <li>
            ${currentProduct.phone}
          </li>
          <li>
            ${currentProduct.price}
          </li>
          <li>
            ${currentProduct.detail}
          </li>
        </ul>
      </div>

      <div id="qr-code-container" class="block"></div>
    </div>



  </div>
</template>
<script>

  import QRCodeStyling from 'qr-code-styling';
  export default (props, { $f7route, $store, $on, $el }) => {
    const products = $store.getters.products;
    const productId = +$f7route.params.id;
    let currentProduct;
    products.value.forEach((product) => {
      console.log(product, productId);

      if (product.id !== productId) {
        return;
      }
      currentProduct = product;
    });

    $on('pageInit', () => {
      // const query = "product=1 Kilo de Papa&price=1000&message=this is the message";
      // const data = Object.fromEntries(new URLSearchParams(query));
      // console.log(data);

      const { phone, name, price, detail } = currentProduct;
      console.log(currentProduct);

      const qrCode = new QRCodeStyling({
        width: 300,
        height: 300,
        type: 'svg',
        data: `phone=${phone}&name=${name}&price=${price}&detail=${detail}`,
        image: '', // link to image
        dotsOptions: {
          color: '#4267b2',
          type: 'square'
        },
        backgroundOptions: {
          color: '#e9ebee',
        },
        imageOptions: {
          crossOrigin: 'anonymous',
          margin: 20
        }
      });

      const container = $el.value.find('#qr-code-container')[0];
      qrCode.append(container);
      // qrCode.download({ name: "qr", extension: "svg" });
      // window.location.href = `sms:83256474?body=message`;
    })

    return $render;
  };
</script>