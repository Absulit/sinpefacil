<template>
  <div class="page" data-name="product">
    <div class="navbar">
      <div class="navbar-bg"></div>
      <div class="navbar-inner sliding">
        <div class="left">
          <a href="#" class="link back">
            <i class="icon icon-back"></i>
          </a>
        </div>
        <div class="title">${currentProduct.name}</div>

        <div class="right">
          <!-- Edit QR -->
          <a href="#" class="link icon-only popup-open" @click="${() => $f7.emit('openQRDataPopup', currentProduct.id)}"
            id="btn-pin">
            <i class="f7-icons">pencil</i>
          </a>
          <!-- Overflow / More Menu -->
          <a href="#" class="link icon-only popover-open" data-popover=".popover-menu">
            <i class="f7-icons">ellipsis_vertical</i>
          </a>
        </div>



      </div>
    </div>

    <!-- Popover for the 3-dot overflow menu -->
    <div class="popover popover-menu">
      <div class="popover-inner">
        <div class="list">
          <ul>
            <li><a href="#" class="list-button popover-close" @click=${()=>deleteProduct()}>Delete</a></li>
            <li><a href="#" class="list-button popover-close" @click=${()=>printProduct()}>Print</a></li>

          </ul>
        </div>
      </div>
    </div>

    <div class="page-content">
      <div class="block-title">${currentProduct.name}</div>
      <div class="block">
        <ul>
          ${currentProduct && currentProduct.phone ? $h`<li>${currentProduct.phone}</li>` : ''}
          ${currentProduct && currentProduct.price ? $h`<li>${currentProduct.price}</li>` : ''}
          ${currentProduct && currentProduct.detail ? $h`<li>${currentProduct.detail}</li>` : ''}
        </ul>
      </div>

      <div id="qr-code-container" class="block text-align-center"></div>
    </div>

  </div>
</template>
<script>

  import QRCodeStyling from 'qr-code-styling';
  export default (props, { $f7, $f7route, $store, $on, $el, $update }) => {
    const products = $store.getters.products;
    const productId = +$f7route.params.id;
    let currentProduct;
    products.value.forEach(product => {
      if (product.id !== productId) {
        return;
      }
      currentProduct = product;
    });

    $on('pageInit', () => {
      const { phone, name, price, detail } = currentProduct;
      console.log(currentProduct);

      const url = encodeURI(`${window.location.origin}?phone=${phone}&name=${name}&price=${price}&detail=${detail}`);

      const qrCode = new QRCodeStyling({
        width: 300,
        height: 300,
        type: 'svg',
        data: url,
        image: '', // link to image
        dotsOptions: {
          color: '#000000',
          type: 'square'
        },
        backgroundOptions: {
          color: '#e9ebee',
        },
        imageOptions: {
          crossOrigin: 'anonymous',
          margin: 20
        }
      });

      const container = $el.value.find('#qr-code-container')[0];
      qrCode.append(container);
      // qrCode.download({ name: "qr", extension: "svg" });
    })
    $f7.on('PRODUCT_UPDATED', productUpdated => {
      console.log('PRODUCT_UPDATED', productUpdated);
      currentProduct = productUpdated;
      $update();
    })

    $on('pageBeforeRemove', () => {
      console.log('pageBeforeRemove');
      $f7.off('PRODUCT_UPDATED');
    });

    const deleteProduct = () => {
      $f7.dialog.confirm(`Desea borrar '${currentProduct.name}'?`, () => {
        console.log('Item deleted', currentProduct);

        $f7.preloader.show();
        // TODO: verify if delete was successful
        $store.dispatch('deleteProduct', currentProduct.id);
        $store.dispatch('initApp');
        $f7.preloader.hide();
        $f7.views.current.router.back('/codes/', { force: true });

        $f7.toast.create({
          text: 'Código borrado',
          closeTimeout: 2000,
        }).open();
      });
    }

    const printProduct = () => {
      console.log('printProduct');
    }

    return $render;
  };
</script>