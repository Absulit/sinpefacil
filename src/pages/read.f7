<template>
  <div class="page" data-name="read ">

    <!-- Top Navbar -->
    <div class="navbar">
      <div class="navbar-bg"></div>
      <div class="navbar-inner">
        <!-- <div class="left">
          <a href="#" class="link icon-only panel-open" data-panel="left">
            <i class="icon f7-icons if-not-md">menu</i>
            <i class="icon material-icons if-md">menu</i>
          </a>
        </div> -->
        <div class="title sliding display-flex align-items-center">
          <div class="title">${i18next.t('read')}</div>
        </div>
        <div class="right">
          <a href="#" class="link icon-only panel-open" data-panel="right">
            <i class="icon f7-icons if-not-md">menu</i>
            <i class="icon material-icons if-md">menu</i>
          </a>

        </div>
        <!-- <div class="title-large">
          <div class="title-large-text">SINPE Fácil</div>
        </div> -->
      </div>
    </div>

    <div class="page-content display-flex flex-direction-column">
      <video id="cam" autoplay playsinline muted
        style="width: 100%; height: 100%; max-height: 100vh; background: #000; display: block;">
      </video>
    </div>
  </div>
</template>
<script>
  import i18next from 'i18next';
  import QrScanner from 'qr-scanner';
  import { db, getBankId } from 'db';
  import generateSINPESMS, { validateSMS, SMS_START } from 'sms';
  import { LangEvent, CamEvent } from 'events';
  import { clearParams, validateEntryData } from 'urldata';
  import { HistoryEvent } from 'events';
  import { deriveKey, decrypt } from 'crypto';
  import $$ from 'dom7';

  function getPIN($f7) {
    return new Promise((resolve, reject) => {
      const maxChars = 4;

      let pin = '';

      const dialog = $f7.dialog.create({
        title: 'Digitar PIN',
        content: `
        <div class="pin-display" style="font-size: 28px; letter-spacing: 8px; margin: 15px 0; font-weight: bold; font-family: monospace;">____</div>
        <div class="pin-numpad" style="display: grid; grid-template-columns: repeat(3, 1fr); gap: 10px; margin-top: 10px;">
          ${[1, 2, 3, 4, 5, 6, 7, 8, 9, 'C', 0, 'OK'].map(val =>
          `<button type="button" class="button button-fill pin-btn" data-val="${val}" style="height: 48px; font-size: 18px;">${val}</button>`
        ).join('')}
        </div>
      `,
        buttons: [
          {
            text: 'Cancelar',
            role: 'cancel',
            onClick: () => resolve(null)
          }
        ]
      }).open();

      // keypad buttons
      dialog.$el.find('.pin-btn').on('click', function () {
        const val = $$(this).dataset().val;

        if (val === 'C') {
          pin = '';
        } else if (val === 'OK') {
          if (pin.length === maxChars) {
            dialog.close();
            resolve(pin);
            return;
          } else {
            $f7.toast.show({ text: `PIN debe ser de ${maxChars} digitos`, closeTimeout: 1500 });
          }
        } else if (pin.length < maxChars) {
          pin += val;
        }

        // Update mask display (e.g., '•••___')
        const masked = '•'.repeat(pin.length) + '_'.repeat(maxChars - pin.length);
        dialog.$el.find('.pin-display').text(masked);
      });
    });
  }

  let qrScanner = null;
  export default (props, { $f7, $on, $el, $store, $update }) => {

    let isNavigating = false;
    let isInvalid = false;
    let showInvalidNotification = true;
    const onDecode = async result => {

      if (isNavigating) return;
      isNavigating = true;

      const encryptedData = JSON.parse(result.data);
      console.log(encryptedData);
      const { iv, salt, ciphertext } = encryptedData;

      const pin = await getPIN($f7)
      const decryptionKey = await deriveKey(pin, salt);

      const decryptedData = await decrypt(
        ciphertext,
        iv,
        decryptionKey
      );
      console.log(decryptedData);















      if (!decryptedData.includes(window.location.origin)) {
        showInvalidNotification && $f7.toast.create({
          text: i18next.t('validation:QRInvalid'),
          closeTimeout: 2000,
          position: 'center',
          on: {
            open: () => {
              showInvalidNotification = false;
            },
            close: _ => {
              showInvalidNotification = true;
            }
          }
        }).open();

        isNavigating = false;
        return
      }

      const data = Object.fromEntries(new URL(decryptedData).searchParams);

      const validData = validateEntryData(data);
      if (!validData) {
        clearParams();
        showInvalidNotification && $f7.dialog.create({
          title: 'SINPE Fácil',
          text: i18next.t('validation:QRInvalid'),
          buttons: [{ text: 'OK' }],
          on: {
            open: () => {
              showInvalidNotification = false;
            },
            close: _ => {
              showInvalidNotification = true;
            }
          }
        }).open();

        isNavigating = false;
        return
      }

      const { phone, name, price, detail } = validData;

      const isValid = validateSMS(SMS_START, price, phone, name, detail);
      if (!isValid) {
        $f7.dialog.confirm(i18next.t('validation:linkLength'), 'SINPE Fácil')
        return;
      }

      // if ($f7.device.ios) {
      //   // rawData = rawData.replace('?body=', '&body=');
      // }

      const bankId = await getBankId();
      const bank = await db.banks.get(bankId);

      $f7.dialogSMSConfirm({ bank: bank.shortname, price, phone, name, detail },
        async () => {
          $store.dispatch('addHistoryItem', { price, phone, name, detail, createdAt: new Date() });
          $f7.emit(HistoryEvent.ADDED);
          window.location.href = generateSINPESMS(bank.phone, price, phone, name, detail)
          isNavigating = false;
        },
        () => {
          // Reset flag if user cancels
          isNavigating = false;
          $f7.toast.create({
            text: i18next.t('read:notSendToast'),
            closeTimeout: 2000,
          }).open();
        }
      )


      // const link = document.createElement('a');
      // link.href = `sms:${888}?body=PASE ${price} ${phone} ${detail}`;
      // document.body.appendChild(link);
      // link.click();
      // document.body.removeChild(link);
    }

    $on('pageInit', async (e, page) => {

      $f7.$(document).on('tab:show', async (e, page) => {
        const id = e.target.getAttribute('data-name');
        if ('read' !== id) return;

        const bankId = await getBankId();

        if (!bankId) {
          $f7.dialog.confirm(
            i18next.t('read:CTASelectBank'),
            'SINPE Fácil',
            () => {
              $f7.views.current.router.navigate('/settings/')
            },
            () => {
              // Reset flag if user cancels
              const tabLink = document.querySelectorAll('.tab-link')[0]
              $f7.tab.show(`#view-home`, tabLink, true);
            }
          );
        }

        isNavigating = false;
        const cam = document.getElementById('cam');
        qrScanner = new QrScanner(
          cam,
          onDecode,
          {
            highlightScanRegion: true,
            returnDetailedScanResult: true
          }
        );
        qrScanner.start();

      })

      $f7.$(document).on('tab:hide', async (e, page) => {
        const id = e.target.getAttribute('data-name');
        if ('read' !== id) return;
        qrScanner?.stop();;
        qrScanner?.destroy();
        qrScanner = null;
      })


      $f7.on(CamEvent.RESTART, async () => {
        isNavigating = false;
        const cam = document.getElementById('cam');

        if (cam?.paused) return;
        qrScanner = new QrScanner(
          cam,
          onDecode,
          {
            highlightScanRegion: true,
            returnDetailedScanResult: true
          }
        );
        qrScanner.start();
      })

      $f7.on(LangEvent.UPDATED, () => $update());
    })

    return $render;
  };
</script>