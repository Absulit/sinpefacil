<template>
  <div class="page" data-name="read ">

    <!-- Top Navbar -->
    <div class="navbar">
      <div class="navbar-bg"></div>
      <div class="navbar-inner">
        <!-- <div class="left">
          <a href="#" class="link icon-only panel-open" data-panel="left">
            <i class="icon f7-icons if-not-md">menu</i>
            <i class="icon material-icons if-md">menu</i>
          </a>
        </div> -->
        <div class="title sliding display-flex align-items-center">
          <div class="title">${i18next.t('read')}</div>
        </div>
        <div class="right">
          <a href="#" class="link icon-only panel-open" data-panel="right">
            <i class="icon f7-icons if-not-md">menu</i>
            <i class="icon material-icons if-md">menu</i>
          </a>

        </div>
        <!-- <div class="title-large">
          <div class="title-large-text">SINPE Fácil</div>
        </div> -->
      </div>
    </div>

    <div class="page-content display-flex flex-direction-column">
      <video id="cam" autoplay playsinline muted
        style="width: 100%; height: 100%; max-height: 100vh; background: #000; display: block;">
      </video>
    </div>
  </div>
</template>
<script>
  import i18next from 'i18next';
  import QrScanner from 'qr-scanner';
  import { db, getBankId } from 'db';
  import generateSINPESMS, { validateSMS, SMS_START } from 'sms';
  import { LangEvent, CamEvent } from 'events';
  import { clearParams, validateEntryData } from 'urldata';

  let qrScanner = null;
  export default (props, { $f7, $on, $el, $store, $update }) => {

    let isNavigating = false;
    let isInvalid = false;
    let showInvalidNotification = true;
    const onDecode = async result => {
      if (isNavigating) return;
      isNavigating = true;

      if (!result.data.includes(window.location.origin)) {
        showInvalidNotification && $f7.toast.create({
          text: i18next.t('validation:QRInvalid'),
          closeTimeout: 2000,
          position: 'center',
          on: {
            open: () => {
              showInvalidNotification = false;
            },
            close: _ => {
              showInvalidNotification = true;
            }
          }
        }).open();

        isNavigating = false;
        return
      }

      const data = Object.fromEntries(new URL(result.data).searchParams);

      const validData = validateEntryData(data);
      if (!validData) {
        clearParams();
        showInvalidNotification && $f7.dialog.create({
          title: 'SINPE Fácil',
          text: i18next.t('validation:QRInvalid'),
          buttons: [{ text: 'OK' }],
          on: {
            open: () => {
              showInvalidNotification = false;
            },
            close: _ => {
              showInvalidNotification = true;
            }
          }
        }).open();

        isNavigating = false;
        return
      }

      const { phone, name, price, detail } = validData;

      const isValid = validateSMS(SMS_START, price, phone, name, detail);
      if (!isValid) {
        $f7.dialog.confirm(i18next.t('validation:linkLength'), 'SINPE Fácil')
        return;
      }

      $store.dispatch('addHistoryItem', { price, phone, name, detail, createdAt: new Date() })
      // if ($f7.device.ios) {
      //   // rawData = rawData.replace('?body=', '&body=');
      // }

      const bankId = await getBankId();
      const bank = await db.banks.get(bankId);

      $f7.dialogSMSConfirm({ bank: bank.shortname, price, phone, name, detail },
        async () => {
          window.location.href = generateSINPESMS(bank.phone, price, phone, name, detail)
          isNavigating = false;
        },
        () => {
          // Reset flag if user cancels
          isNavigating = false;
          $f7.toast.create({
            text: i18next.t('read:notSendToast'),
            closeTimeout: 2000,
          }).open();
        }
      )


      // const link = document.createElement('a');
      // link.href = `sms:${888}?body=PASE ${price} ${phone} ${detail}`;
      // document.body.appendChild(link);
      // link.click();
      // document.body.removeChild(link);
    }

    $on('pageInit', async (e, page) => {

      $f7.$(document).on('tab:show', async (e, page) => {
        const id = e.target.getAttribute('data-name');
        if ('read' !== id) return;

        const bankId = await getBankId();

        if (!bankId) {
          $f7.dialog.confirm(
            i18next.t('read:CTASelectBank'),
            'SINPE Fácil',
            () => {
              $f7.views.current.router.navigate('/settings/')
            },
            () => {
              // Reset flag if user cancels
              const tabLink = document.querySelectorAll('.tab-link')[0]
              $f7.tab.show(`#view-home`, tabLink, true);
            }
          );
        }

        isNavigating = false;
        const cam = document.getElementById('cam');
        qrScanner = new QrScanner(
          cam,
          onDecode,
          {
            highlightScanRegion: true,
            returnDetailedScanResult: true
          }
        );
        qrScanner.start();

      })

      $f7.$(document).on('tab:hide', async (e, page) => {
        const id = e.target.getAttribute('data-name');
        if ('read' !== id) return;
        qrScanner?.stop();;
        qrScanner?.destroy();
        qrScanner = null;
      })


      $f7.on(CamEvent.RESTART, async () => {
        isNavigating = false;
        const cam = document.getElementById('cam');

        if (cam?.paused) return;
        qrScanner = new QrScanner(
          cam,
          onDecode,
          {
            highlightScanRegion: true,
            returnDetailedScanResult: true
          }
        );
        qrScanner.start();
      })

      $f7.on(LangEvent.UPDATED, () => $update());
    })

    return $render;
  };
</script>