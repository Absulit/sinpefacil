<template>
  <div class="page" data-name="read ">
    <div class="navbar">
      <div class="navbar-bg"></div>
      <div class="navbar-inner sliding">
        <div class="title">read </div>
      </div>
    </div>
    <div class="page-content display-flex flex-direction-column">
      <video id="cam" autoplay playsinline muted
        style="width: 100%; height: 100%; max-height: 100vh; background: #000; display: block;">
      </video>

    </div>
  </div>
</template>
<script>
  import i18next from 'i18next';
  import QrScanner from 'qr-scanner';
  function takePhoto() {
    console.log('---- takePhoto');

  }

  export default (props, { $f7, $on, }) => {
    $on('pageInit', () => {
      let isNavigating = false;
      const cam = document.getElementById('cam');
      const qrScanner = new QrScanner(
        cam,
        result => {
          if (isNavigating) return;
          isNavigating = true;

          console.log('decoded qr code:', result)
          // Object.entries(result).forEach(([key, value]) => {
          //   alert(`${key}: ${value}`);
          // });
          const data = Object.fromEntries(new URL(result.data).searchParams);
          const { phone, name, price, detail } = data;

          // if ($f7.device.ios) {
          //   // rawData = rawData.replace('?body=', '&body=');
          // }

          // qrScanner.stop();


          $f7.dialog.confirm(
            'Open Messages app to send SMS?',
            'QR Code Scanned',
            () => {
              window.location.href = `sms:${888}?body=PASE ${price} ${phone} ${name} ${detail}`;
              isNavigating = false;
            },
            () => {
              // Reset flag if user cancels
              isNavigating = false;
            }
          );








          // const link = document.createElement('a');
          // link.href = `sms:${888}?body=PASE ${price} ${phone} ${detail}`;
          // document.body.appendChild(link);
          // link.click();
          // document.body.removeChild(link);



        },
        {
          highlightScanRegion: true,
          returnDetailedScanResult: true
        }
      );
      qrScanner.start();
    })

    return $render;
  };
</script>