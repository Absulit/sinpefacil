<template>
  <div class="page" data-name="codes">
    <div class="navbar">
      <div class="navbar-bg"></div>
      <div class="navbar-inner sliding">
        <div class="title">Codes</div>
      </div>
    </div>
    <div class="page-content">
      <div class="list list-strong list-dividers-ios list-outline-ios inset-md">
        <ul>
          ${products.value.map((product) => $h`
          <li>
            <a class="item-content item-link" href="/product/${product.id}/">
              <div class="item-inner">
                <div class="item-title">${product.title}</div>
              </div>
            </a>
          </li>
          `)}
        </ul>
      </div>
      ${products.value.length === 3 && $h`
      <div class="block">
        <button class="button button-fill" @click=${addProduct}>Add Product</Button>
      </div>
      `}

      <div id="qr-code-container" class="block"></div>

    </div>
  </div>
</template>
<script>
  import QRCodeStyling from 'qr-code-styling';
  export default (props, { $store, $on, $el }) => {

    $on('pageInit', () => {

      const qrCode = new QRCodeStyling({
        width: 300,
        height: 300,
        type: "svg",
        data: "1000&this is the message",
        image: "", // link to image
        dotsOptions: {
          color: "#4267b2",
          type: "rounded"
        },
        backgroundOptions: {
          color: "#e9ebee",
        },
        imageOptions: {
          crossOrigin: "anonymous",
          margin: 20
        }
      });

      const container = $el.value.find('#qr-code-container')[0];
      qrCode.append(container);
      // qrCode.download({ name: "qr", extension: "svg" });

      // window.location.href = `sms:83256474?body=message`;

    })










    const products = $store.getters.products;

    const addProduct = () => {
      $store.dispatch('addProduct', {
        id: '4',
        title: 'Apple iPhone 12',
        description: 'Lorem ipsum dolor sit amet, consectetur adipisicing elit. Nisi tempora similique reiciendis, error nesciunt vero, blanditiis pariatur dolor, minima sed sapiente rerum, dolorem corrupti hic modi praesentium unde saepe perspiciatis.'
      });
    }

    return $render;
  }

</script>