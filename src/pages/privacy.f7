<template>
  <div class="page" data-name="privacy">
    <div class="navbar">
      <div class="navbar-bg"></div>
      <div class="navbar-inner sliding">
        <div class="left">
          <a href="#" class="link back">
            <i class="icon icon-back"></i>
          </a>
        </div>
        <div class="title">${i18next.t('privacy:title')}</div>
      </div>
    </div>
    <div class="page-content">
      <div class="block privacy">
        ${{privacyContent}}
      </div>


    </div>
  </div>
</template>
<script>
  import i18next from 'i18next';
  export default async (props, { $f7, $el, $on }) => {

    const lang = i18next.language;
    const response = await fetch(`./assets/docs/privacy.${lang}.html`);
    const privacyContent = await response.text();

    $on('pageInit', async page => {

      const privacyEl = $el.value.find('div.privacy');
      privacyEl.html(privacyContent)
    })

    return $render;
  }
</script>
